# ---- Firebase (required for auth, database & storage) ----
# Get these from Firebase Console → Project settings → Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server-side) ----
# Generate a service-account key in Firebase Console → Project settings →
# Service accounts → "Generate new private key", then copy the values here.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Amazon S3 bucket (photo source for import) ----
# Create a bucket at console.aws.amazon.com/s3 and an IAM user with
# AmazonS3ReadOnlyAccess at console.aws.amazon.com/iam → Users → Create access key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# ---- Optional: Google Drive import ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin (used for OAuth redirects; default localhost:3000)
APP_ORIGIN=http://localhost:3000
