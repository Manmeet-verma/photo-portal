# ---- Firebase (required for auth, database & storage) ----
# Get these from Firebase Console → Project settings → Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server-side) ----
# Generate a service-account key in Firebase Console → Project settings →
# Service accounts → "Generate new private key", then copy the values here.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Optional: Google Drive import ----
# Create an OAuth Client ID (Web application) at console.cloud.google.com,
# enable the Google Drive API, and add the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin (used for Drive OAuth redirects; default localhost:3000)
APP_ORIGIN=http://localhost:3000